{
  "id": "node_1_2",
  "theory": [
    {
      "title": "Salutare in Portogallo",
      "text": "In Portogallo si saluta sempre, anche entrando in un negozio o al bar, e il saluto cambia con l'ora del giorno. Vediamo le espressioni una alla volta: ascoltale e ricopiale, poi le ripasserai a memoria."
    },
    {
      "vocabStudy": {
        "groups": [
          {
            "label": "Saluti del giorno",
            "items": [
              "bom-dia",
              "boa-tarde",
              "boa-noite"
            ]
          },
          {
            "label": "Tra amici",
            "items": [
              "ola",
              "como-estas",
              "tudo-bem"
            ]
          },
          {
            "label": "Apresentações",
            "items": [
              "chamo-me",
              "muito-prazer"
            ]
          }
        ]
      }
    }
  ],
  "exercises": [
