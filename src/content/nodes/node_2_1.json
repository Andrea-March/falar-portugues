  "theory": [
    {
      "title": "Come stai? Dov'è?",
      "text": "In Portogallo, dopo il saluto si chiede quasi sempre come va. E in città ti servirà chiedere dove si trovano le cose. Prima le espressioni per chiedere come stai, poi quelle per chiedere e indicare un posto."
    },
    {
      "vocabStudy": {
        "groups": [
          {
            "label": "Come stai",
            "items": [
              "como-estas",
              "tudo-bem",
              "estou-bem"
            ]
          },
          {
            "label": "Dove si trova",
            "items": [
              "onde-esta",
              "esta-aqui",
              "esta-ali"
            ]
          }
        ]
      }
    }
