  "theory": [
    {
      "title": "Ao telefone com o Pedro",
      "text": "Il tuo amico Pedro ti chiama: vuole sapere come stai e dove sei, per raggiungerti al bar del signor Manuel. Ti serviranno **estou**, **está** ed **estamos**.",
      "examples": [
        {
          "pt": "Estou no café.",
          "it": "Sono al bar."
        },
        {
          "pt": "Está ali!",
          "it": "È lì!"
        }
      ]
    }
  ],
  "exercises": [
    {
