{
  "id": "node_1_1",
  "theory": [
    {
      "title": "Identità e Origine",
      "text": "Il verbo **Ser** si usa per caratteristiche permanenti, nazionalità, origini e professioni. Nel prossimo capitolo conoscerai **Estar**, per stati temporanei e posizioni.",
      "examples": [
        {
          "pt": "Eu sou italiano.",
          "it": "Io sono italiano."
        },
        {
          "pt": "Ela é médica.",
          "it": "Lei è medica."
        }
      ]
    },
    {
      "paradigm": {
        "verb": "ser",
        "tense": "presente"
      }
    }
  ],
  "exercises": [
    {
      "id": "ex_1_1_1",
      "type": "write",
      "text": "O senhor {é} o novo vizinho?",
      "it": "Lei (formale) è il nuovo vicino?",
      "trains": [
        "verb:ser:presente:ele_ela_voce"
      ]
    },
    {
      "id": "ex_1_1_2",
      "type": "write",
      "text": "Eles {são} de Coimbra.",
      "it": "Loro sono di Coimbra.",
      "trains": [
        "verb:ser:presente:eles_elas_voces"
      ]
    },
    {
      "id": "ex_1_1_3",
      "type": "write",
      "text": "Tu {és} estudante de línguas?",
      "it": "Tu sei studente di lingue?",
      "trains": [
        "verb:ser:presente:tu"
      ]
    },
    {
      "id": "ex_1_1_4",
      "type": "write",
      "text": "Eu {sou} arquiteto em Lisboa.",
      "it": "Io sono architetto a Lisbona.",
      "trains": [
        "verb:ser:presente:eu"
      ]
    },
    {
      "id": "ex_1_1_5",
      "type": "write",
      "text": "Vocês {são} muito bem-vindos.",
      "it": "Voi siete molto benvenuti.",
      "trains": [
        "verb:ser:presente:eles_elas_voces"
      ]
    },
    {
      "id": "ex_1_1_6",
      "type": "write",
      "text": "Nós {somos} portugueses.",
      "it": "Noi siamo portoghesi.",
      "trains": [
        "verb:ser:presente:nos"
      ]
    }
  ]
}