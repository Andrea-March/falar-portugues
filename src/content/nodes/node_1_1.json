{
  "id": "node_1_1",
  "theory": [
    {
      "title": "Identità e Origine",
      "text": "Il verbo **Ser** serve per dire chi sei: nome, nazionalità, provenienza, professione. Con i saluti che già conosci basta per presentarti. Nel prossimo capitolo conoscerai **Estar**, per stati temporanei e posizioni.",
      "examples": [
        {
          "pt": "Olá, chamo-me Marco. Sou de Itália.",
          "it": "Ciao, mi chiamo Marco. Vengo dall'Italia."
        },
        {
          "pt": "Ela é médica.",
          "it": "Lei è medica."
        },
        {
          "pt": "Muito prazer! Somos os novos vizinhos.",
          "it": "Piacere! Siamo i nuovi vicini."
        }
      ]
    },
    {
      "paradigm": {
        "verb": "ser",
        "tense": "presente"
      }
    }
  ],
  "exercises": [
