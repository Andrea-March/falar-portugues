{
  "id": "node_2_1",
  "theory": [
    {
      "title": "Come stai? Dov'è?",
      "text": "Em Itália, depois do cumprimento pergunta-se quase sempre como estás. E na cidade vais precisar de perguntar onde ficam as coisas. Primeiro as expressões para perguntar como está alguém, depois as que servem para perguntar e indicar um sítio."
    },
    {
      "vocabStudy": {
        "groups": [
          {
            "label": "Como estás",
            "items": [
              "come-stai",
              "come-sta",
              "sto-bene"
            ]
          },
          {
            "label": "Onde fica",
            "items": [
              "dove-e",
              "e-qui",
              "e-li"
            ]
          }
        ]
      }
    }
  ],
  "warmup": {
    "speaker": {
      "name": "Signora Rossi",
      "role": "Vicina di casa · Firenze",
      "avatar": "👵🏻"
    },
    "exercises": [
      {
        "id": "warm_it_2_1_1",
        "type": "choose",
        "context": "Buongiorno, Ines! Come sta?",
        "contextTranslation": "Bom dia, Ines! Como está?",
        "prompt": "Responde que estás bem",
        "text": "{Sto bene}, grazie! E lei?",
        "translation": "Estou bem, obrigada! E a senhora?",
        "trains": [
          "vocab:sto-bene"
        ],
        "wrong": [
          "Come stai",
          "Piacere"
        ]
      },
      {
        "id": "warm_it_2_1_2",
        "type": "choose",
        "context": "Bene, grazie! Ecco mio nipote, Marco.",
        "contextTranslation": "Bem, obrigada! Aqui está o meu neto, o Marco.",
        "prompt": "O Marco é um rapaz: pergunta-lhe como está",
        "text": "Ciao Marco, {come stai}?",
        "translation": "Olá Marco, como estás?",
        "trains": [
          "vocab:come-stai"
        ],
        "wrong": [
          "come sta",
          "sto bene"
        ],
        "learnerNote": "Com um rapaz usas o «tu»: «come stai?». Com a senhora Rossi era «come sta?»."
      }
    ]
  },
  "exercises": [
    {
      "id": "it_2_1_1",
      "type": "choose",
      "text": "Ciao Giulia! {Come stai}?",
