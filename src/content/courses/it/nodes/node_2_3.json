        "translation": "Estou em casa.",
        "trains": [
          "verb:essere:presente:io"
        ]
      },
      {
        "id": "it_2_3_t3",
        "type": "write",
        "context": "E Marco come sta?",
        "contextTranslation": "E o Marco, como está?",
        "prompt": "Diz que o Marco está bem",
        "text": "Marco {sta} bene.",
        "translation": "O Marco está bem.",
        "trains": [
          "verb:stare:presente:lui_lei"
