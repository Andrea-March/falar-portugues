{
  "id": "node_1_1",
  "theory": [
    {
      "title": "Cumprimentar em Itália",
      "text": "Em Itália cumprimenta-se sempre, também ao entrar numa loja ou num café, e o cumprimento muda com a hora do dia. Vamos ver as expressões uma de cada vez: ouve-as e copia-as, depois vais revê-las de memória."
    },
    {
      "vocabStudy": {
        "groups": [
          {
            "label": "Cumprimentos do dia",
            "items": [
              "buongiorno",
              "buonasera",
              "buonanotte"
            ]
          },
          {
            "label": "Apresentar-se e despedir-se",
            "items": [
              "ciao",
              "mi-chiamo",
              "piacere",
              "arrivederci"
            ]
          }
        ]
      }
    }
  ],
  "warmup": {
    "speaker": {
      "name": "Signora Rossi",
      "role": "Vicina di casa · Firenze",
      "avatar": "👵🏻"
    },
    "exercises": [
      {
        "id": "warm_it_1_1_1",
        "type": "choose",
        "context": "Buongiorno! Lei è la nuova vicina?",
        "contextTranslation": "Bom dia! A senhora é a nova vizinha?",
        "prompt": "É de manhã: responde ao cumprimento",
        "text": "{Buongiorno}, signora!",
        "translation": "Bom dia, minha senhora!",
        "trains": [
          "vocab:buongiorno"
        ],
        "wrong": [
          "Buonanotte",
          "Ciao"
        ]
      },
      {
        "id": "warm_it_1_1_2",
        "type": "choose",
        "context": "Io mi chiamo Maria Rossi.",
        "contextTranslation": "Eu chamo-me Maria Rossi.",
        "prompt": "Ela apresentou-se: responde",
        "text": "{Piacere}, signora Rossi!",
        "translation": "Muito prazer, senhora Rossi!",
        "trains": [
          "vocab:piacere"
        ],
        "wrong": [
          "Arrivederci",
          "Buonasera"
        ]
      }
    ]
  },
  "exercises": [
    {
