        "text": "Grazie. {Quant'è}?",
        "translation": "Obrigada. Quanto é?",
        "trains": [
          "vocab:quant-e"
        ]
      },
      {
        "id": "it_1_3_t5",
        "type": "write",
        "context": "Un euro e ottanta. Grazie!",
        "contextTranslation": "Um euro e oitenta. Obrigada!",
        "prompt": "Responde ao agradecimento",
        "text": "{Prego}! Buonasera.",
        "translation": "De nada! Boa noite.",
        "trains": [
