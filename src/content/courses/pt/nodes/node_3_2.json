{
  "id": "node_3_2",
  "theory": [
    {
      "title": "Ter: avere",
      "text": "Il verbo **ter** vuol dire avere, e si usa quasi sempre come in italiano: per quello che hai, per il tempo (**não tenho tempo**) e per l'età (**tenho trinta anos**). Con **Tens horas?** chiedi l'ora a un amico.",
      "examples": [
        {
          "text": "Não tenho tempo hoje.",
          "translation": "Non ho tempo oggi."
        },
        {
          "text": "Tenho trinta anos.",
          "translation": "Ho trent'anni.",
          "learnerNote": "Come in italiano «ho trent'anni»: per l'età si usa «ter», non «ser»."
        },
        {
          "text": "Tens horas?",
          "translation": "Hai l'ora?",
          "learnerNote": "Domanda informale per chiedere l'ora. Con chi dai del Lei: «Tem horas?»."
        }
      ]
    },
    {
      "paradigm": {
        "verb": "ter",
        "tense": "presente"
      }
    }
  ],
  "exercises": [
